APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# SPA (browser) origin — used for OAuth redirects, CORS, and sitemap URLs
FRONTEND_APP_URL=http://localhost:5173

# Sitemap cache TTL (seconds); served at GET /sitemap.xml — proxy from frontend host
# SITEMAP_CACHE_TTL=3600

# OAuth (optional) — callback URLs must match routes on this API (typically ${APP_URL}/api/auth/.../callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=${APP_URL}/api/auth/google/callback
#
# Sign in with LinkedIn (OpenID Connect) — create app at https://www.linkedin.com/developers/
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URL=${APP_URL}/api/auth/linkedin/callback
#
# Optional: GitHub classic PAT — server-wide fallback for "Fill from GitHub" (rate limits + any repos the PAT can read)
# GITHUB_TOKEN=
#
# Optional: GitHub OAuth App — per-user import from private repos (authorize in Profile). Callback must match this API route:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=${APP_URL}/api/auth/github/import/callback
#
# THROTTLE_OAUTH_GITHUB_IMPORT_URL_PER_MINUTE=20

# Geo pricing fallback when IP/country cannot be detected (local dev): tunisia | international
# PRICING_DEFAULT_REGION=international

# Free tier limits
# FREE_OWNED_RESUME_LIMIT=1
# FREE_AI_ENHANCE_PER_MONTH=5
# FREE_AI_TAILOR_PER_MONTH=1
# FREE_AI_ATS_PER_MONTH=3
# FREE_AI_MONTHLY_TOKEN_LIMIT=1000
# PRO_AI_MONTHLY_TOKEN_LIMIT=50000
# Per-call AI logs (tokens) for admins: GET /api/admin/ai-usage/* (see docs/features/admin-ai-usage.md)

# Paddle Pro (international checkout) — see docs/features/paddle-billing.md
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_ID_INTERNATIONAL=pri_...
# PADDLE_CHECKOUT_SUCCESS_URL=${FRONTEND_APP_URL}/pricing/success

# Legacy Stripe (existing subscribers only)
# STRIPE_KEY=pk_test_...
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_INTERNATIONAL=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=${FRONTEND_APP_URL}/pricing/success
# STRIPE_CHECKOUT_CANCEL_URL=${FRONTEND_APP_URL}/pricing

# Comma-separated origins allowed to call the API with credentials (production: https://hresume.com,https://www.hresume.com)
# If unset, local dev defaults apply; FRONTEND_APP_URL is always merged in when set.
# CORS_ALLOWED_ORIGINS=https://hresume.com,https://www.hresume.com

# Sanctum: hosts that may use cookie+session auth (no scheme). Include SPA hostname(s) and local dev.
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,hresume.com,www.hresume.com
# SANCTUM_TOKEN_EXPIRATION_MINUTES=120

# Cross-origin SPA (different site than API): use none + secure cookies in production
# SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=

# Rate limits (requests per minute) — see config/rate-limit.php
# THROTTLE_LOGIN_PER_MINUTE=5
# THROTTLE_REGISTER_PER_MINUTE=5
# THROTTLE_AUTHENTICATED_PER_MINUTE=120
# THROTTLE_PDF_GENERATE_PER_MINUTE=15
# THROTTLE_AI_TAILOR_PER_MINUTE=10
# THROTTLE_GITHUB_IMPORT_PER_MINUTE=20

# AI provider
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# Free-tier option (Groq)
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Days after signup before unverified accounts may be removed (shown in verification reminder emails)
# UNVERIFIED_ACCOUNT_DELETION_DAYS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
